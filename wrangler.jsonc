{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holbery-marketplace",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // Orders, audit events, rate limits (first-party Duitku POP checkout).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holbery-marketplace-production",
      "database_id": "8ba51323-0825-4d48-9e8c-12fa7efee54a",
      "migrations_dir": "migrations"
    }
  ],

  // PRIVATE bucket for paid deliverables. No public access / r2.dev URL is enabled.
  "r2_buckets": [{ "binding": "DELIVERABLES", "bucket_name": "holbery-marketplace-deliverables" }],

  // Non-secret configuration. Secrets (DUITKU_MERCHANT_CODE, DUITKU_API_KEY) are
  // stored ONLY as encrypted Pages secrets: `wrangler pages secret put <NAME>`.
  "vars": {
    "SITE_URL": "https://holbery-marketplace.pages.dev",
    "DUITKU_ENV": "production",
    // Kill switch ("true"/"false"). Even when "true", only catalog products that pass every gate (published,
    // reviews passed, protected_download + private R2 file) can be bought, and SUPPORT_CONTACT must be set.
    "CHECKOUT_ENABLED": "true",
    "TERMS_VERSION": "HBM-TERMS-2026-10-DRAFT",
    "SUPPORT_CONTACT": ""
  }
}
