# HOLBERY Marketplace — sanitized environment example.
# The current storefront does NOT require any secret to run.
# Copy to .dev.vars for local `wrangler pages dev` only if a future feature needs it.
# NEVER commit real values. Production secrets go in: wrangler pages secret put <NAME>

# Public canonical site URL used for SEO metadata, sitemap and robots.txt.
# Configured as a plain (non-secret) variable.
SITE_URL=https://holbery-marketplace.pages.dev

# --- Secrets: production values live ONLY in encrypted Cloudflare Pages secrets ---
# For local dev put TEST values in .dev.vars (gitignored). Never paste real keys in chat or Git.
DUITKU_MERCHANT_CODE=DXXXX
DUITKU_API_KEY=replace-with-test-key

# --- Plain vars (configured in wrangler.jsonc) ---
# DUITKU_ENV=production
# CHECKOUT_ENABLED=true
# TERMS_VERSION=HBM-TERMS-2026-10-DRAFT
# SUPPORT_CONTACT=
